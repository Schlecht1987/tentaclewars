<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TowerDefense" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">#141821</item>
        <item name="android:navigationBarColor">#141821</item>
        <item name="android:windowBackground">#141821</item>
    </style>

    <!-- Flache Spiel-Buttons ohne Material-Tint (Hintergrund kommt per Drawable) -->
    <style name="GameButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>
</resources>
