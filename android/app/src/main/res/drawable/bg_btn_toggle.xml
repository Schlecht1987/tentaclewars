<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#3A3A28" />
            <stroke android:width="2dp" android:color="#FFD75E" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3A4560" />
            <stroke android:width="1dp" android:color="#55628A" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2A3247" />
            <stroke android:width="1dp" android:color="#3D4761" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
