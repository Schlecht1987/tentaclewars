<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#232A3A" />
            <stroke android:width="1dp" android:color="#303950" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#57BD6C" android:endColor="#3B944F" android:angle="270" />
            <stroke android:width="1dp" android:color="#74D689" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#46A85A" android:endColor="#2E7D42" android:angle="270" />
            <stroke android:width="1dp" android:color="#62C46F" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
