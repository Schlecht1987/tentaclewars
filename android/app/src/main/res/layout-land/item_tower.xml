<?xml version="1.0" encoding="utf-8"?>
<!-- Shop-Zeile (Querformat): Turm-Vorschau links, Name/Beschreibung/Kosten rechts -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="6dp"
    android:background="@drawable/bg_shop_item"
    android:clickable="true"
    android:focusable="true">

    <de.schlecht.towerdefense.TowerIconView
        android:id="@+id/towerIcon"
        android:layout_width="40dp"
        android:layout_height="40dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/towerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E8ECF4"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/towerDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8A93A8"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/towerCost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFD75E"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
