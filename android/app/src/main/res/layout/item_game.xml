<?xml version="1.0" encoding="utf-8"?>
<!-- Spielkarte in der Bibliothek -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/bg_shop_item"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/gameIcon"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="34sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/gameName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E8ECF4"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gameDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#8A93A8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/gameProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#FFD75E"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="▶"
        android:textColor="#62C46F"
        android:textSize="22sp" />
</LinearLayout>
