<?xml version="1.0" encoding="utf-8"?>
<!-- Level-Kachel in der Kampagnen-Auswahl -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="@drawable/bg_shop_item"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/lvStatus"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFD75E" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E8ECF4"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lvMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFD75E"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/lvDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8A93A8"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
