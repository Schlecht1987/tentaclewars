<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080E18">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HUD oben -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#0D1626"
            android:paddingLeft="10dp"
            android:paddingRight="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <LinearLayout
                android:id="@+id/zkChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/zkHint"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:gravity="center"
                android:textColor="#77839B"
                android:textSize="9sp"
                android:maxLines="2"
                android:text="" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/zkPause"
                style="@style/GameButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:minHeight="36dp"
                android:background="@drawable/bg_btn_secondary"
                android:textSize="13sp"
                android:text="⏸" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/zkRestart"
                style="@style/GameButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minWidth="44dp"
                android:minHeight="36dp"
                android:background="@drawable/bg_btn_secondary"
                android:textSize="13sp"
                android:text="🔄" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/zkMenuBtn"
                style="@style/GameButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:minWidth="44dp"
                android:minHeight="36dp"
                android:background="@drawable/bg_btn_secondary"
                android:textSize="13sp"
                android:text="☰" />
        </LinearLayout>

        <!-- Spielfeld -->
        <de.schlecht.towerdefense.zell.ZellView
            android:id="@+id/zkView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Levelauswahl -->
    <ScrollView
        android:id="@+id/zkMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5080E18"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🦠 Zellkrieg"
                android:textColor="#EAF2FA"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Zellen erobern: Tentakel von eigenen Zellen zu Zielen ziehen. Kampagne mit 50 Leveln – oder Zufallsspiel gegen 1–3 KIs."
                android:textColor="#8593A1"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/zkResume"
                style="@style/GameButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:text="▶ Weiter spielen" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/zkRandomBtn"
                    style="@style/GameButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_primary"
                    android:textSize="13sp"
                    android:text="🎲 Zufallsspiel" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/zkSandboxBtn"
                    style="@style/GameButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:textSize="13sp"
                    android:text="🧪 Testlabor" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="KAMPAGNE"
                android:textColor="#8593A1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <LinearLayout
                android:id="@+id/zkGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Zelltypen:  ⭕ Normal (1/s, max 50) · ➕ Heiler (Heilung ×2) · 🌀 Angreifer (Angriff ×2) · ⚙️ Fabrik (2/s, max 25) · ⬡ Bunker (max 100, halbiert Schaden)"
                android:textColor="#77839B"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Zufallsspiel-Formular -->
    <ScrollView
        android:id="@+id/zkRandom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5080E18"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎲 Zufallsspiel"
                android:textColor="#EAF2FA"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/zkRandomOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/zkSeedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#8593A1"
                    android:textSize="13sp"
                    android:text="Karte #0" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/zkReroll"
                    style="@style/GameButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:textSize="12sp"
                    android:text="🎲 Neu würfeln" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/zkRandomStart"
                    style="@style/GameButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_btn_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="▶ Spiel starten" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/zkRandomBack"
                    style="@style/GameButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:textSize="13sp"
                    android:text="← Zurück" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
